<div id="registerModal" class="modal" aria-hidden="true" style="display:none;">
  <div class="modal-content" role="dialog" aria-modal="true" aria-label="<%= t('nav.register') %>">
    <button class="close" data-close-register aria-label="<%= t('auth.close') %>">&times;</button>
    <h3><%= t('nav.register') %></h3>
    <form id="registerForm">
      <div class="form-group">
        <label for="reg-username"><%= t('auth.nickname') %></label>
        <input type="text" id="reg-username" name="username" placeholder="<%= t('auth.nicknamePlaceholder') %>" autocomplete="username" required>
      </div>
      <div class="form-group">
        <label for="reg-email"><%= t('auth.email') %></label>
        <input type="email" id="reg-email" name="email" placeholder="<%= t('auth.emailPlaceholder') %>" autocomplete="email" required>
      </div>
      <div class="form-group">
        <label for="reg-password"><%= t('auth.password') %></label>
        <input type="password" id="reg-password" name="password" placeholder="<%= t('auth.passwordPlaceholder') %>" autocomplete="new-password" minlength="6" required>
      </div>
      <div class="form-group">
        <label><%= t('auth.accountType') %></label>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
          <label style="display:flex;gap:8px;align-items:flex-start;padding:10px;border:1px solid rgba(31,138,90,.3);border-radius:8px;cursor:pointer;">
            <input type="radio" name="accountType" value="services">
            <span><%= t('auth.accountTypeServices') %><br><small style="opacity:.7"><%= t('auth.accountTypeServicesHint') %></small></span>
          </label>
          <label style="display:flex;gap:8px;align-items:flex-start;padding:10px;border:1px solid rgba(31,138,90,.3);border-radius:8px;cursor:pointer;">
            <input type="radio" name="accountType" value="showcase" required>
            <span><%= t('auth.accountTypeAds') %><br><small style="opacity:.7"><%= t('auth.accountTypeAdsHint') %></small></span>
          </label>
        </div>
      </div>
      <div class="form-group">
        <label for="reg-refCode"><%= t('auth.refCode') %></label>
        <input type="text" id="reg-refCode" name="refCode" placeholder="<%= t('auth.refCodePlaceholder') %>">
      </div>
      <button type="submit" class="btn primary"><%= t('auth.createAccount') %></button>
    </form>
    <div id="registerError" class="error" style="color:#b00020;margin-top:10px;display:none;"></div>
    <div id="registerSuccess" style="color:green;margin-top:10px;display:none;"></div>
  </div>
</div>
