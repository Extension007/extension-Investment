<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('auth.verifyEmailTitle') %> - Albamount</title>
  <link rel="stylesheet" href="/styles.css?v=1.4.0">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.6.0/axios.min.js"></script>
</head>
<body>
  <div id="bg-animated" aria-hidden="true"></div>
  <header class="main-header">
    <div class="container header-inner">
      <a class="logo" href="/"><img src="/albamount.png" alt="ALBAMOUNT" class="logo-img"></a>
      <div class="header-actions">
        <%- include('partials/lang-switcher') %>
        <a class="btn outline" href="/"><%= t('common.back') %></a>
      </div>
    </div>
  </header>

  <main>
    <div class="container verification-page">
      <h1 class="page-title"><%= t('auth.verifyEmailTitle') %></h1>
      
      <div class="profile-content">
        <div class="profile-card">
          <h2><%= t('auth.username') %></h2>
          
          <div class="profile-info">
            <p><strong><%= t('auth.username') %>:</strong> <%= typeof user !== 'undefined' ? user.username : '—' %></p>
            <p><strong><%= t('auth.email') %>:</strong> <%= typeof user !== 'undefined' ? user.email : '—' %></p>
            
            <div class="verification-status">
              <% if (typeof user !== 'undefined' && user.emailVerified) { %>
                <span class="status-badge verified">? <%= t('auth.verifyEmailSuccess') %></span>
              <% } else { %>
                <span class="status-badge unverified">? <%= t('auth.verifyEmailPending') %></span>
                
                <div class="verification-actions">
                  <button id="resendVerificationBtn" class="btn outline"><%= t('auth.resendVerification') %></button>
                  <div id="resendStatus"></div>
                </div>
              <% } %>
            </div>
          
          <div class="actions">
            <a href="/cabinet" class="btn primary"><%= t('nav.cabinet') %></a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/mobile-tabs') %>

  <script>
    window.__I18N__ = <%- JSON.stringify(typeof i18nBundle !== 'undefined' ? i18nBundle : { locale: 'en', js: {} }) %>;
  </script>
  <script src="/js/i18n-client.js"></script>
  <script>
    document.getElementById('resendVerificationBtn')?.addEventListener('click', async function() {
      try {
        const response = await axios.post('/resend-verification', {
          email: "<%= typeof user !== 'undefined' ? user.email : '' %>",
          _csrf: '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>'
        });
        
        const statusDiv = document.getElementById('resendStatus');
        statusDiv.textContent = '';
        const box = document.createElement('div');
        box.className = response.data.success ? 'success-message' : 'error-message';
        box.textContent = response.data.message || (window.i18nT ? window.i18nT('resendVerificationSent', 'Verification email sent. Check your inbox.') : 'Verification email sent. Check your inbox.');
        statusDiv.appendChild(box);
      } catch (error) {
        const statusDiv = document.getElementById('resendStatus');
        const errorMessage = error.response?.data?.message || (window.i18nT ? window.i18nT('networkError', 'Error') : 'Error');
        statusDiv.textContent = '';
        const box = document.createElement('div');
        box.className = 'error-message';
        box.textContent = errorMessage;
        statusDiv.appendChild(box);
      }
    });
  </script>
</body>
</html>
