<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
  <title><%= typeof t === 'function' ? t('auth.submitLogin') : 'Вход' %> — Admin</title>
  <meta name="robots" content="noindex, nofollow">
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      min-height: 100vh;
      padding: 24px 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    form {
      width: 100%;
      max-width: 360px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    input {
      width: 100%;
      padding: 12px;
      font-size: 16px;
    }
    button {
      padding: 12px;
      background: linear-gradient(#0d281c, #0d281c) padding-box,
                  linear-gradient(45deg, #c9a227, #e6c96a) border-box;
      color: #fff;
      border: 2px solid transparent;
      border-radius: 12px;
      cursor: pointer;
      min-height: 44px;
      box-shadow: 0 0 10px rgba(31, 138, 90, 0.35), 0 0 22px rgba(31, 138, 90, 0.2);
      transition: box-shadow .2s ease, transform .15s ease, filter .2s ease;
    }
    button:hover {
      box-shadow: 0 0 14px rgba(31, 138, 90, 0.55), 0 0 28px rgba(31, 138, 90, 0.28);
      transform: translateY(-1px);
      filter: brightness(1.03);
    }
    .error {
      color: red;
      margin-top: 10px;
      text-align: center;
    }
    .debug {
      margin-top: 20px;
      padding: 10px;
      background: #f4f4f4;
      border: 1px solid #ccc;
      width: 100%;
      max-width: 360px;
      font-size: 12px;
      color: #333;
      overflow: auto;
    }
    .lang-wrap { margin-bottom: 16px; align-self: stretch; display: flex; justify-content: flex-end; width: 100%; max-width: 360px; }
    @media (max-width: 480px) {
      body { padding: 16px 12px; }
    }
  </style>
  <link rel="stylesheet" href="/styles.css?v=1.4.0">
</head>
<body>
  <div id="bg-animated" aria-hidden="true"></div>
  <div class="lang-wrap"><%- include('partials/lang-switcher') %></div>
  <h2><%= typeof t === 'function' ? t('nav.admin') : 'Админ' %></h2>

  <form method="POST" action="/admin/login">
    <input type="text" name="username" placeholder="<%= typeof t === 'function' ? t('auth.username') : 'Логин' %>" required>
    <input type="password" name="password" placeholder="<%= typeof t === 'function' ? t('auth.password') : 'Пароль' %>" required>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit"><%= typeof t === 'function' ? t('auth.submitLogin') : 'Войти' %></button>
  </form>

  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <% if (debug) { %>
    <div class="debug">
      <strong>Debug:</strong><br>
      <pre><%= JSON.stringify(debug, null, 2) %></pre>
    </div>
  <% } %>
</body>
</html>
