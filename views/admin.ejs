<strong class="price"><%= typeof formatPriceDisplay === 'function' ? formatPriceDisplay(s.price, s.currency) : s.price %></strong>
</div>

<!-- Р’Р»Р°РґРµР»РµС† -->
<% if (s.owner) { %>
<% if (typeof s.owner === 'object' && s.owner.username) { %>
<p class="muted" style="text-align:center;font-size:0.85rem;margin-top:5px;">
Р’Р»Р°РґРµР»РµС†: <%= s.owner.username %>
</p>
<% } else { %>
<p class="muted" style="text-align:center;font-size:0.85rem;margin-top:5px;">
Р’Р»Р°РґРµР»РµС†: ID <%= s.owner %>
