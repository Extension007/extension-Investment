<% } else { %>
<p class="muted" style="text-align:center;font-size:0.85rem;margin-top:5px;color:#f44336;">
Р’Р»Р°РґРµР»РµС† РЅРµ СѓРєР°Р·Р°РЅ (СЃРѕР·РґР°РЅРѕ Р°РґРјРёРЅРѕРј)
</p>
<% } %>

<!-- РљР°С‚РµРіРѕСЂРёСЏ -->
<% if (categories && s.category) { %>
<p class="muted" style="text-align:center;font-size:0.85rem;margin-top:5px;">
<%= categories[s.category] || s.category %>
</p>
<% } %>

<div class="product-actions admin-card-actions">
<form method="POST" action="/admin/services/<%= s.id %>/toggle-visibility" onsubmit="return confirm('Р�Р·РјРµРЅРёС‚СЊ РІРёРґРёРјРѕСЃС‚СЊ СЌС‚РѕР№ РєР°СЂС‚РѕС‡РєРё?');">
<input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
<button type="submit" class="btn small status-<%= s.status %>">
<%= s.status === 'approved' ? 'Р—Р°Р±Р»РѕРєРёСЂРѕРІР°С‚СЊ' : 'Р Р°Р·Р±Р»РѕРєРёСЂРѕРІР°С‚СЊ' %>
</button>
</form>

<a class="btn small outline" href="/admin/services/<%= s.id %>/edit">Р РµРґР°РєС‚РёСЂРѕРІР°С‚СЊ</a>

<form method="POST" action="/admin/services/<%= s.id %>/delete" style="display:inline" onsubmit="return confirm('РЈРґР°Р»РёС‚СЊ РєР°СЂС‚РѕС‡РєСѓ?');">
<input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
<button type="submit" class="btn small outline">РЈРґР°Р»РёС‚СЊ</button>
</form>

<% if (s.link) { %>
<a class="btn small outline" href="<%= s.link %>" target="_blank" rel="noopener">РЎСЃС‹Р»РєР°</a>
<% } %>
<% if (s.video_url) { %>
<button type="button" class="btn small outline" data-video="<%= s.video_url %>">Р’РёРґРµРѕ</button>
<% } %>
</div>

<!-- Р РµР№С‚РёРЅРі (С‚РѕР»СЊРєРѕ РѕС‚РѕР±СЂР°Р¶РµРЅРёРµ) -->
<div class="product-rating" data-id="<%= s.id %>" style="margin-top:10px;">
<button class="btn icon" type="button" disabled aria-label="Р›Р°Р№Рє">^</button>
<span class="result"><%= (s.likes || 0) - (s.dislikes || 0) %></span>
<button class="btn icon" type="button" disabled aria-label="Р”РёР·Р»Р°Р№Рє">РЋ</button>
<span class="votes">(<%= (s.likes || 0) + (s.dislikes || 0) %> РіРѕР»РѕСЃРѕРІ)</span>
</div>
</div>
</div>
<% }) %>
</div>
<% } else { %>
<p class="empty-state">РџРѕРєР° РЅРµС‚ СѓСЃР»СѓРі</p>
<% } %>
</section>

</main>

<footer class="footer">
  <p></p>
</footer>

<!-- РњРѕРґР°Р»СЊРЅРѕРµ РѕРєРЅРѕ РґР»СЏ РѕС‚РєР»РѕРЅРµРЅРёСЏ -->
<dialog id="rejectModal" class="reject-dialog">
  <form id="rejectForm" method="POST">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' && csrfToken ? csrfToken : '' %>">
    <h3 id="rejectModalTitle">РћС‚РєР»РѕРЅРёС‚СЊ РєР°СЂС‚РѕС‡РєСѓ</h3>
    <textarea name="rejectionReason" placeholder="РџСЂРёС‡РёРЅР° РѕС‚РєР»РѕРЅРµРЅРёСЏ" rows="4" required></textarea>
    <textarea name="adminComment" placeholder="РљРѕРјРјРµРЅС‚Р°СЂРёР№ Р°РґРјРёРЅРёСЃС‚СЂР°С‚РѕСЂР° (РЅРµРѕР±СЏР·Р°С‚РµР»СЊРЅРѕ)" rows="2"></textarea>
    <div class="reject-dialog-actions">
      <button type="submit" class="btn">РћС‚РєР»РѕРЅРёС‚СЊ</button>
      <button type="button" class="btn outline" data-close-reject>РћС‚РјРµРЅР°</button>
    </div>
  </form>
</dialog>

<!-- FIX: РџРѕР»РЅРѕСЌРєСЂР°РЅРЅС‹Р№ overlay РґР»СЏ YouTube РІРёРґРµРѕ -->
<div id="videoOverlay" class="video-overlay" aria-hidden="true" style="display:none;">
<div class="video-overlay-container">
<button class="video-overlay-close" data-close-video aria-label="Р—Р°РєСЂС‹С‚СЊ РІРёРґРµРѕ">&times;</button>
<div class="video-overlay-iframe-container" id="videoIframeContainer">
<!-- FIX: iframe СЃРѕР·РґР°РµС‚СЃСЏ РґРёРЅР°РјРёС‡РµСЃРєРё РїРѕ РєР»РёРєСѓ -->
</div>
</div>
</div>


<!-- РџРµСЂРµРґР°РµРј РёРЅС„РѕСЂРјР°С†РёСЋ Рѕ РґРѕСЃС‚СѓРїРЅРѕСЃС‚Рё Socket.IO РЅР° РєР»РёРµРЅС‚ -->
<!-- Bootstrap script for safe EJS > JS data transfer -->
 <script src="/utils/bootstrap.js?v=1.0.3"></script>
  <script>
    window.AppBootstrap.init({
      isAuth: true,
      isAdmin: true,
      socketIoAvailable: typeof socket_io_available !== 'undefined' ? socket_io_available : false,
      userRole: typeof userRole !== 'undefined' ? userRole : 'admin',
      userId: <%- JSON.stringify(typeof user !== 'undefined' && user && (user.id || user._id) ? String(user.id || user._id) : '') %>,
      csrfToken: typeof csrfToken !== 'undefined' ? csrfToken : ''
    });
  </script>

  <script src="/script.js?v=1.1.3"></script>
  <script>
  document.addEventListener('DOMContentLoaded', function() {
    if (window.__ADMIN_BOOTSTRAP_DONE) return;
    window.__ADMIN_BOOTSTRAP_DONE = true;

    const CSRF_TOKEN = <%- JSON.stringify(csrfToken ? String(csrfToken) : '') %>;

    async function postJSON(url, data) {
      const payload = Object.assign({ _csrf: CSRF_TOKEN }, data || {});
      const res = await fetch(url, {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-CSRF-Token': CSRF_TOKEN
        },
        body: JSON.stringify(payload)
      });
      const text = await res.text();
      let json = {};
      try { json = text ? JSON.parse(text) : {}; } catch (e) { json = {}; }
      return { ok: res.ok, status: res.status, json: json, text: text };
    }

    const logoutForm = document.getElementById('logoutForm');
    if (logoutForm) {
      logoutForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        e.stopPropagation();
        if (!confirm('Р’С‹ СѓРІРµСЂРµРЅС‹, С‡С‚Рѕ С…РѕС‚РёС‚Рµ РІС‹Р№С‚Рё?')) return;
        try {
          const csrf = (typeof CSRF_TOKEN !== 'undefined' && CSRF_TOKEN)
            || document.querySelector('input[name="_csrf"]')?.value
            || '';
          const res = await fetch('/logout', {
            method: 'POST',
            headers: {
              'X-CSRF-Token': csrf,
              'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: '_csrf=' + encodeURIComponent(csrf)
          });
          if (res.ok) {
            window.location.href = '/';
          }
        } catch (err) {
          window.location.href = '/';
        }
      });
    }

    document.querySelectorAll('button[data-video]').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        var url = btn.getAttribute('data-video');
        if (!url) return;
        if (typeof window.openVideoOverlay === 'function') {
          window.openVideoOverlay(url);
          return;
        }
        var overlay = document.getElementById('videoOverlay');
        var box = document.getElementById('videoIframeContainer');
        if (!url || !overlay || !box) return;
        var id = null;
        var m = url.match(/[?&]v=([^&]+)/) || url.match(/youtu\.be\/([^?&/]+)/) || url.match(/\/embed\/([^?&/]+)/) || url.match(/\/shorts\/([^?&/]+)/);
        if (m) id = m[1];
        box.innerHTML = '';
        var iframe = document.createElement('iframe');
        if (id) {
          iframe.src = 'https://www.youtube.com/embed/' + encodeURIComponent(id) + '?rel=0&modestbranding=1&playsinline=1&origin=' + encodeURIComponent(window.location.origin);
          iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
          iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        } else {
          iframe.src = url;
        }
        iframe.setAttribute('allow', 'accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen');
        iframe.setAttribute('allowfullscreen', '');
        iframe.style.cssText = 'position:absolute;left:0;top:0;width:100%;height:100%;border:0;';
        box.appendChild(iframe);
        overlay.classList.add('show');
        overlay.style.display = 'flex';
        overlay.setAttribute('aria-hidden', 'false');
      });
    });

    const approveBtns = document.querySelectorAll('.approve-btn');
    approveBtns.forEach(function(btn) {
      btn.addEventListener('click', async function(e) {
        e.preventDefault();
        e.stopPropagation();
        const id = btn.getAttribute('data-id');
        if (!confirm('РћРґРѕР±СЂРёС‚СЊ СЌС‚Сѓ РєР°СЂС‚РѕС‡РєСѓ?')) return;
        try {
          const itemType = btn.getAttribute('data-type') || 'product';
          const endpoint = '/admin/' + itemType + 's/' + id + '/approve';

          const result = await postJSON(endpoint);
          if (result.json.success) {
            alert('РљР°СЂС‚РѕС‡РєР° РѕРґРѕР±СЂРµРЅР°!');
            location.reload();
          } else {
            alert('РћС€РёР±РєР°: ' + (result.json.message || ('HTTP ' + result.status)));
          }
        } catch (err) {
          alert('РћС€РёР±РєР° СЃРµС‚Рё: ' + err.message);
        }
      });
    });

    const toggleBtns = document.querySelectorAll('.toggle-visibility-btn');
    toggleBtns.forEach(function(btn) {
      btn.addEventListener('click', async function(e) {
        e.preventDefault();
        e.stopPropagation();
        const id = btn.getAttribute('data-id');
        const currentStatus = btn.getAttribute('data-status');
        const itemType = btn.getAttribute('data-type') || 'product';
        const action = (currentStatus === 'approved' || currentStatus === 'published') ? 'Р·Р°Р±Р»РѕРєРёСЂРѕРІР°С‚СЊ' : 'СЂР°Р·Р±Р»РѕРєРёСЂРѕРІР°С‚СЊ';
        if (!confirm('Р’С‹ СѓРІРµСЂРµРЅС‹, С‡С‚Рѕ С…РѕС‚РёС‚Рµ ' + action + ' СЌС‚Сѓ РєР°СЂС‚РѕС‡РєСѓ?')) return;

        try {
          const endpoint = '/admin/' + itemType + 's/' + id + '/toggle-visibility';
          const result = await postJSON(endpoint);
          if (result.json.success) {
            alert(result.json.message || 'РЎС‚Р°С‚СѓСЃ РєР°СЂС‚РѕС‡РєРё РёР·РјРµРЅРµРЅ');
            location.reload();
          } else {
            alert('РћС€РёР±РєР°: ' + (result.json.message || ('HTTP ' + result.status)));
          }
        } catch (err) {
          alert('РћС€РёР±РєР° СЃРµС‚Рё: ' + err.message);
        }
      });
    });

    const rejectModal = document.getElementById('rejectModal');
    const rejectForm = document.getElementById('rejectForm');

    document.querySelectorAll('.reject-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        if (!rejectModal || !rejectForm) return;
        const id = btn.getAttribute('data-id');
        const itemType = btn.getAttribute('data-type') === 'service' ? 'services' : 'products';
        rejectForm.action = '/admin/' + itemType + '/' + id + '/reject';
        const title = document.getElementById('rejectModalTitle');
        if (title) title.textContent = 'РћС‚РєР»РѕРЅРёС‚СЊ РєР°СЂС‚РѕС‡РєСѓ';
        if (typeof rejectModal.showModal === 'function') {
          if (!rejectModal.open) rejectModal.showModal();
        } else {
          rejectModal.style.display = 'block';
        }
      });
    });

    const closeRejectBtn = document.querySelector('[data-close-reject]');
    if (closeRejectBtn) {
      closeRejectBtn.addEventListener('click', function() {
        if (rejectModal && typeof rejectModal.close === 'function') rejectModal.close();
        else if (rejectModal) rejectModal.style.display = 'none';
        if (rejectForm) rejectForm.reset();
      });
    }
  });
  </script>
<style>
