.toggle-visibility-btn.status-approved {
background:#f44336;
color:#fff;
}
.toggle-visibility-btn.status-rejected {
background:#4caf50;
color:#fff;
}
.toggle-visibility-btn.status-pending {
background:#4caf50;
color:#fff;
}

