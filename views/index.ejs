<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
<head>
  <meta charset="UTF-8">
  <title><%= typeof activeTab !== 'undefined' && activeTab === 'services' ? t('meta.servicesTitle') : t('meta.adsTitle') %></title>
  <%- include('partials/seo-head', {
    canonicalPath: '/ad',
    seoTitle: typeof activeTab !== 'undefined' && activeTab === 'services' ? t('meta.servicesTitle') : t('meta.adsTitle'),
    seoDescription: t('meta.adsDescription')
  }) %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.youtube.com https://s.ytimg.com https://fonts.googleapis.com https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.instagram.com https://graph.instagram.com wss://socket.io https://*.cloudinary.com https://localhost:* http://localhost:*; frame-src 'self' https://www.youtube.com https://youtube.com https://www.youtube-nocookie.com https://m.youtube.com https://vk.com https://m.vk.com https://vk.ru https://vkvideo.ru https://www.vkvideo.ru https://instagram.com https://www.instagram.com;">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css?v=1.3.9">
  <link rel="stylesheet" href="/header-tabs.css?v=1.1.3">
  <link rel="stylesheet" href="/catalog-tiles.css?v=1.0.9">
</head>
<body class="catalog-tiles" data-logged-in="<%= typeof isAuth !== 'undefined' && isAuth ? '1' : '0' %>">
  <script>window.IS_AUTH = document.body.getAttribute('data-logged-in') === '1';</script>
  <div id="bg-animated" aria-hidden="true"></div>
  <% if (typeof showSiteIntro === 'undefined' || showSiteIntro) { %>
  <input type="checkbox" id="siteIntroDismiss" class="site-intro-toggle">
  <label for="siteIntroDismiss" id="siteIntro" class="site-intro">
    <span class="site-intro-inner">
      <img src="/albamount.png" alt="ALBAMOUNT" class="site-intro-logo">
      <span id="siteIntroTitle" class="site-intro-title"><%= t('intro.title') %></span>
      <span id="siteIntroText" class="site-intro-text"><%= t('intro.text') %></span>
      <span class="site-intro-steps">
        <span><%= t('intro.step1') %></span>
        <span><%= t('intro.step2') %></span>
        <span><%= t('intro.step3') %></span>
      </span>
      <span class="site-intro-hint"><%= t('intro.hint') %></span>
    </span>
  </label>
  <script src="/intro.js?v=1.0.0"></script>
  <% } %>
  <%- include('partials/header') %>

  <main>
    <section id="catalog" class="section">
      <div class="section-header">
        <h2><%= typeof activeTab !== 'undefined' && activeTab === 'services' ? t('catalog.services') : t('catalog.ads') %></h2>
        <div class="category-selector-container">
          <button id="openCategories" type="button" class="btn small outline">
            <%= t('catalog.categories') %> <span style="opacity:.8">(<%= selectedCategory === 'all' ? t('catalog.allLower') : selectedCategory %>)</span>
          </button>
          <div id="categoriesMenu" class="dropdown-menu hierarchical-categories" aria-hidden="true">
            <button class="dropdown-item" data-category="all"><%= t('catalog.all') %></button>
            <!-- Блоки категорий будут загружены динамически -->
            <div id="categoriesBlocks" class="categories-blocks">
              <!-- Здесь будут отображаться блоки (корневые категории) -->
            </div>
            <!-- Контейнер для подкатегорий -->
            <div id="subcategoriesContainer" class="subcategories-container" style="display: none;">
              <button class="back-to-blocks-btn" id="backToBlocks"><%= t('catalog.backToBlocks') %></button>
              <div id="subcategoriesList">
                <!-- Подкатегории будут загружены динамически -->
              </div>
            </div>
          </div>
        </div>
      </div>
      <%- include('partials/catalog-search', { searchAction: '/ad', activeTab: 'products' }) %>

      <div id="product-grid" class="product-grid">
        <% if (products && products.length) { %>
          <% products.forEach(p => { %>
            <%- include('partials/catalog-tile', {
              card: p,
              ratingClass: 'product-rating',
              descriptionLabel: t('catalog.descriptionProduct'),
              catalogPath: '/ad'
            }) %>
          <% }) %>
        <% } else { %>
          <p class="empty-state"><%= t('catalog.emptyProducts') %></p>
        <% } %>
      </div>
    </section>

    <!-- Секция услуг перенесена в отдельную страницу /services -->

    <!-- Модальные окна чата для всех карточек -->
    <% if (products && products.length) { %>
      <% products.forEach(p => { %>
        <div class="chat-modal" id="chat-modal-<%= p._id %>" style="display: none;">
          <div class="chat-modal-overlay" data-close-chat-modal="<%= p._id %>"></div>
          <div class="chat-modal-content">
            <div class="chat-modal-header">
              <h3><%= t('catalog.chatTitle') %></h3>
              <button class="chat-close-btn" data-close-chat-modal="<%= p._id %>" type="button">×</button>
            </div>
            <div class="chat-messages" id="chat-messages-<%= p._id %>">
            </div>
            <div class="chat-input-container">
              <textarea
                class="chat-input"
                id="chat-input-<%= p._id %>"
                placeholder="<%= t('catalog.messagePlaceholder') %>"
                maxlength="1000"
                rows="2"
              ></textarea>
              <button class="chat-send-btn" data-send-chat-message="<%= p._id %>" type="button"><%= t('catalog.send') %></button>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>

    <% if (services && services.length) { %>
      <% services.forEach(s => { %>
        <div class="chat-modal" id="chat-modal-<%= s._id %>" style="display: none;">
          <div class="chat-modal-overlay" data-close-chat-modal="<%= s._id %>"></div>
          <div class="chat-modal-content">
            <div class="chat-modal-header">
              <h3><%= t('catalog.chatTitle') %></h3>
              <button class="chat-close-btn" data-close-chat-modal="<%= s._id %>" type="button">×</button>
            </div>
            <div class="chat-messages" id="chat-messages-<%= s._id %>">
            </div>
            <div class="chat-input-container">
              <textarea
                class="chat-input"
                id="chat-input-<%= s._id %>"
                placeholder="<%= t('catalog.messagePlaceholder') %>"
                maxlength="1000"
                rows="2"
              ></textarea>
              <button class="chat-send-btn" data-send-chat-message="<%= s._id %>" type="button"><%= t('catalog.send') %></button>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </main>


  <%- include('partials/mobile-tabs') %>

<!-- FIX: Полноэкранный overlay для YouTube видео -->
<div id="videoOverlay" class="video-overlay" aria-hidden="true" style="display:none;">
  <div class="video-overlay-container">
    <button class="video-overlay-close" data-close-video aria-label="<%= t('catalog.closeVideo') %>">&times;</button>
    <div class="video-overlay-iframe-container" id="videoIframeContainer">
      <!-- FIX: iframe создается динамически по клику, пустой при загрузке -->
    </div>
  </div>
</div>

<!-- FIX: Overlay для просмотра изображений в полном размере -->
<div id="imageOverlay" class="image-overlay" aria-hidden="true">
  <div class="image-overlay-container">
    <button class="image-overlay-close" data-close-image aria-label="<%= t('catalog.closeImage') %>">&times;</button>
    <img id="imageOverlayImg" src="" alt="" class="image-overlay-img">
    <button class="image-overlay-nav image-overlay-prev" data-image-nav="prev" aria-label="<%= t('catalog.prevImage') %>">‹</button>
    <button class="image-overlay-nav image-overlay-next" data-image-nav="next" aria-label="<%= t('catalog.nextImage') %>">›</button>
  </div>
</div>

<div id="imageModal" class="modal image-modal" aria-hidden="true" style="display:none;">
  <div class="modal-content image-modal-content" role="dialog" aria-modal="true" aria-label="<%= t('catalog.viewImage') %>">
    <button class="close" data-close-image aria-label="<%= t('catalog.closeImage') %>">&times;</button>
    <div class="image-modal-container">
      <button class="image-nav-btn image-nav-prev" aria-label="<%= t('catalog.prevImage') %>">‹</button>
      <div class="image-modal-image-wrapper">
        <img id="imageModalImage" src="" alt="" class="image-modal-image">
        <div class="image-modal-counter">
          <span id="imageModalCurrent">1</span> / <span id="imageModalTotal">1</span>
        </div>
        <div class="image-modal-title" id="imageModalTitle"></div>
      </div>
      <button class="image-nav-btn image-nav-next" aria-label="<%= t('catalog.nextImage') %>">›</button>
    </div>
  </div>
</div>

<div id="descriptionModal" class="modal description-modal" aria-hidden="true" style="display:none;">
  <div class="modal-content description-modal-content" role="dialog" aria-modal="true" aria-label="<%= t('catalog.description') %>">
    <button class="close" data-close-description aria-label="<%= t('auth.close') %>">&times;</button>
    <h3 id="descriptionModalTitle" style="margin-bottom:20px;font-size:1.5rem;color:#fff;"><%= t('catalog.description') %></h3>
    <div id="descriptionModalContent" style="max-height:75vh;overflow-y:auto;padding:20px 0;line-height:1.6;font-size:1.1rem;color:#ddd;">
      <!-- Описание будет вставлено динамически -->
    </div>
  </div>
</div>

<!-- Модальное окно регистрации -->
<%- include('./partials/register-modal') %>

<!-- модальное окно для гостей чата -->
<div id="authModal" class="modal" aria-hidden="true" style="display:none;">
  <div class="modal-content" role="dialog" aria-modal="true" aria-label="<%= t('nav.login') %>">
    <button class="close" data-close-auth aria-label="<%= t('auth.close') %>">&times;</button>
    <h3><%= t('js.loginRequired') %></h3>
    <div style="display:flex;gap:10px;margin-top:20px;">
      <a href="/user/login" class="btn"><%= t('auth.submitLogin') %></a>
      <a href="/register" class="btn outline"><%= t('nav.register') %></a>
    </div>
  </div>
</div>

<!-- Bootstrap script for safe EJS → JS data transfer -->
<script src="/utils/bootstrap.js?v=1.0.3"></script>
<script>
  window.__I18N__ = <%- JSON.stringify(typeof i18nBundle !== 'undefined' ? i18nBundle : { locale: 'en', js: {} }) %>;
  window.AppBootstrap.init({
    isAuth: <%- JSON.stringify(typeof isAuth !== 'undefined' ? isAuth : false) %>,
    isAdmin: <%- JSON.stringify(typeof isAdmin !== 'undefined' ? isAdmin : false) %>,
    socketIoAvailable: <%- JSON.stringify(typeof socket_io_available !== 'undefined' ? socket_io_available : false) %>,
    userRole: <%- JSON.stringify(typeof userRole !== 'undefined' ? userRole : null) %>,
    userId: <%- JSON.stringify(typeof user !== 'undefined' && user && (user.id || user._id) ? String(user.id || user._id) : '') %>,
    isEmailVerified: <%- JSON.stringify(typeof emailVerified !== 'undefined' ? emailVerified : false) %>,
    csrfToken: <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '') %>,
    locale: <%- JSON.stringify(typeof locale !== 'undefined' ? locale : 'en') %>
  });
</script>
<script src="/js/i18n-client.js"></script>

<script>
  var tag = document.createElement('script');
  tag.src = "https://www.youtube.com/iframe_api";
  var firstScriptTag = document.getElementsByTagName('script')[0];
  firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);
</script>

<% if (!process.env.VERCEL) { %>
<script src="/socket.io/socket.io.js"></script>
<% } %>

<script src="/js/location-tags.js?v=1.0.2"></script>
  <script src="/script.js?v=1.1.3"></script>

<!-- Подключаем скрипт для предотвращения перекрытия контента футером -->
<script src="/fix-footer-overlap.js?v=1.0.1"></script>
</body>
</html>
