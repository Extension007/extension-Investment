<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
<head>
  <meta charset="UTF-8">
  <title><%= t('meta.appTitle') %></title>
  <%- include('partials/seo-head', {
    canonicalPath: '/app',
    seoTitle: t('meta.appTitle'),
    seoDescription: t('meta.appDescription')
  }) %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes, viewport-fit=cover">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css?v=1.3.9">
  <link rel="stylesheet" href="/header-tabs.css?v=1.1.3">
  <style>
    .app-download-page {
      max-width: 640px;
      margin: 0 auto;
      color: #eee;
      text-align: center;
      padding: 8px 4px 40px;
    }
    .app-download-page h1 {
      margin: 0 0 10px;
      font-size: 1.7rem;
      font-weight: 700;
    }
    .app-download-page .lead {
      margin: 0 0 28px;
      line-height: 1.65;
      opacity: 0.88;
    }
    .app-platform {
      margin: 0 0 22px;
      padding: 22px 18px;
      border: 1px solid rgba(31, 138, 90, 0.35);
      border-radius: 14px;
      background: rgba(10, 31, 22, 0.55);
      text-align: left;
    }
    .app-platform h2 {
      margin: 0 0 8px;
      font-size: 1.2rem;
    }
    .app-platform .platform-lead {
      margin: 0 0 16px;
      line-height: 1.6;
      opacity: 0.88;
    }
    .app-download-page .btn-download {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 12px 28px;
      font-size: 1.05rem;
      font-weight: 700;
      text-decoration: none;
    }
    .app-download-page .meta {
      margin: 14px 0 0;
      font-size: 0.9rem;
      opacity: 0.65;
    }
    .app-download-page .steps {
      margin: 18px 0 0;
      line-height: 1.7;
      opacity: 0.9;
    }
    .app-download-page .steps h3 {
      margin: 0 0 8px;
      font-size: 1rem;
    }
    .app-download-page .steps ol {
      margin: 0;
      padding-left: 1.25rem;
    }
    .app-download-page .share-box {
      margin-top: 28px;
      padding: 14px 16px;
      border: 1px solid rgba(31, 138, 90, 0.35);
      border-radius: 12px;
      background: rgba(10, 31, 22, 0.55);
      text-align: left;
      word-break: break-all;
    }
    .app-download-page .share-box label {
      display: block;
      font-size: 0.85rem;
      opacity: 0.75;
      margin-bottom: 6px;
    }
    .app-download-page .share-box code {
      font-size: 0.95rem;
      color: #c8f5d8;
    }
    .app-platform .center-cta {
      text-align: center;
    }
  </style>
</head>
<body>
  <%- include('partials/header') %>
  <main class="container" style="padding-top: 100px; padding-bottom: 100px;">
    <div class="app-download-page">
      <h1><%= t('appDownload.title') %></h1>
      <p class="lead"><%= t('appDownload.lead') %></p>

      <section class="app-platform" id="android">
        <h2><%= t('appDownload.androidTitle') %></h2>
        <p class="platform-lead"><%= t('appDownload.androidLead') %></p>
        <div class="center-cta">
          <a class="btn btn-download" href="/downloads/albamount.apk" download="albamount.apk">
            <%= t('appDownload.button') %>
          </a>
          <p class="meta"><%= t('appDownload.version', { version: appVersion || '2.0.1' }) %></p>
        </div>
        <div class="steps">
          <h3><%= t('appDownload.howTitle') %></h3>
          <ol>
            <li><%= t('appDownload.step1') %></li>
            <li><%= t('appDownload.step2') %></li>
            <li><%= t('appDownload.step3') %></li>
          </ol>
        </div>
      </section>

      <section class="app-platform" id="iphone">
        <h2><%= t('appDownload.iosTitle') %></h2>
        <p class="platform-lead"><%= t('appDownload.iosLead') %></p>
        <div class="steps">
          <h3><%= t('appDownload.iosHowTitle') %></h3>
          <ol>
            <li><%= t('appDownload.iosStep1') %></li>
            <li><%= t('appDownload.iosStep2') %></li>
            <li><%= t('appDownload.iosStep3') %></li>
            <li><%= t('appDownload.iosStep4') %></li>
          </ol>
        </div>
        <p class="meta" style="margin-top:16px;"><%= t('appDownload.iosNote') %></p>
      </section>

      <div class="share-box">
        <label><%= t('appDownload.shareLabel') %></label>
        <code>https://www.albamount.xyz/app</code>
      </div>
    </div>
  </main>
  <%- include('partials/mobile-tabs') %>
  <script src="/script.js?v=1.4.3" defer></script>
</body>
</html>
