<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
<head>
  <meta charset="UTF-8">
  <title><%= t('meta.contactsTitle') %></title>
  <%- include('partials/seo-head', {
    canonicalPath: '/contacts',
    seoTitle: t('meta.contactsTitle'),
    seoDescription: t('meta.contactsDescription')
  }) %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css?v=1.4.0">
  <link rel="stylesheet" href="/header-tabs.css?v=1.1.4">
</head>
<body>
  <div id="bg-animated" aria-hidden="true"></div>
  <%- include('partials/header') %>

  <main>
    <section id="contacts" class="section contacts-section">
      <div class="contact-form-section contact-form-only">
        <h2><%= t('contacts.heading') %></h2>
        <p class="contacts-description"><%= t('contacts.description') %></p>
        <form class="contact-form" id="contactForm" method="POST" action="/contacts/send-message">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <div class="form-group">
            <label for="contact-name"><%= t('contacts.name') %></label>
            <input type="text" id="contact-name" name="name" required maxlength="120" placeholder="<%= t('contacts.namePlaceholder') %>" value="<%= user && user.username ? user.username : '' %>">
          </div>
          <div class="form-group">
            <label for="contact-email"><%= t('contacts.email') %></label>
            <input type="email" id="contact-email" name="email" required maxlength="255" placeholder="your@email.com" value="<%= user && user.email ? user.email : '' %>">
          </div>
          <div class="form-group">
            <label for="contact-subject"><%= t('contacts.subject') %></label>
            <select id="contact-subject" name="subject">
              <option value=""><%= t('contacts.subjectPlaceholder') %></option>
              <option value="general"><%= t('contacts.subjectGeneral') %></option>
              <option value="partnership"><%= t('contacts.subjectPartnership') %></option>
              <option value="technical"><%= t('contacts.subjectTechnical') %></option>
              <option value="business"><%= t('contacts.subjectBusiness') %></option>
              <option value="other"><%= t('contacts.subjectOther') %></option>
            </select>
          </div>
          <div class="form-group">
            <label for="contact-message"><%= t('contacts.message') %></label>
            <textarea id="contact-message" name="message" required maxlength="4000" rows="5" placeholder="<%= t('contacts.messagePlaceholder') %>"></textarea>
          </div>
          <button type="submit" class="btn primary contact-submit-btn"><%= t('contacts.submit') %></button>
        </form>
        <div id="contact-success" class="contact-message success" style="display: <%= typeof sent !== 'undefined' && sent ? 'block' : 'none' %>;">
          <%= t('contacts.success') %>
        </div>
        <div id="contact-error" class="contact-message error" style="display: <%= typeof sendError !== 'undefined' && sendError ? 'block' : 'none' %>;">
          <%= t('contacts.error') %>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/mobile-tabs') %>

<%- include('partials/register-modal') %>

<script src="/utils/bootstrap.js?v=1.0.3"></script>
<script>
  window.__I18N__ = <%- JSON.stringify(typeof i18nBundle !== 'undefined' ? i18nBundle : { locale: 'en', js: {} }) %>;
  window.AppBootstrap.init({
    isAuth: <%- JSON.stringify(typeof isAuth !== 'undefined' ? isAuth : false) %>,
    isAdmin: <%- JSON.stringify(typeof isAdmin !== 'undefined' ? isAdmin : false) %>,
    socketIoAvailable: <%- JSON.stringify(typeof socket_io_available !== 'undefined' ? socket_io_available : false) %>,
    userRole: <%- JSON.stringify(typeof userRole !== 'undefined' ? userRole : null) %>,
    userId: <%- JSON.stringify(typeof user !== 'undefined' && user && (user.id || user._id) ? String(user.id || user._id) : '') %>,
    csrfToken: <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '') %>
  });
</script>
<script src="/js/i18n-client.js"></script>
<script src="/script.js?v=1.1.3"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const contactForm = document.getElementById('contactForm');
  const successMessage = document.getElementById('contact-success');
  const errorMessage = document.getElementById('contact-error');

  if (!contactForm) return;

  contactForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    const submitBtn = contactForm.querySelector('.contact-submit-btn');
    const originalText = submitBtn.textContent;
    submitBtn.textContent = <%- JSON.stringify(t('contacts.sending')) %>;
    submitBtn.disabled = true;
    successMessage.style.display = 'none';
    errorMessage.style.display = 'none';

    const formData = new FormData(contactForm);
    const data = Object.fromEntries(formData.entries());
    const csrf = document.querySelector('meta[name="csrf-token"]')?.content || data._csrf || '';

    try {
      const response = await fetch('/contacts/send-message', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-CSRF-Token': csrf
        },
        body: JSON.stringify(data),
        credentials: 'same-origin'
      });
      const text = await response.text();
      let result = {};
      try { result = text ? JSON.parse(text) : {}; } catch (_) {}
      if (response.ok && result.success) {
        successMessage.style.display = 'block';
        successMessage.textContent = result.message || <%- JSON.stringify(t('contacts.success')) %>;
        contactForm.reset();
        successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        errorMessage.textContent = result.message || <%- JSON.stringify(t('contacts.error')) %>;
        errorMessage.style.display = 'block';
      }
    } catch (error) {
      errorMessage.textContent = <%- JSON.stringify(t('contacts.networkCheck')) %>;
      errorMessage.style.display = 'block';
    } finally {
      submitBtn.textContent = originalText;
      submitBtn.disabled = false;
    }
  });
});
</script>
</body>
</html>
