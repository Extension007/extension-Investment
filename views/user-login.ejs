<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
<head>
  <meta charset="UTF-8">
  <title><%= t('meta.loginTitle') %></title>
  <meta name="robots" content="noindex, nofollow">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css?v=1.4.0">
  <style>
    body {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      background: #2b2b2b;
      padding: 20px;
    }
    .login-container {
      background: #1a1a1a;
      padding: 40px;
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.5);
      width: 100%;
      max-width: 400px;
    }
    h2 {
      text-align: center;
      margin-bottom: 30px;
      color: #fff;
    }
    form {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }
    input {
      padding: 12px;
      font-size: 14px;
      border: 1px solid #444;
      border-radius: 8px;
      background: #2b2b2b;
      color: #fff;
    }
    input:focus {
      outline: none;
      border-color: #1f8a5a;
    }
    button {
      padding: 12px;
      background: var(--btn-bg);
      color: var(--color-text);
      border: 2px solid transparent;
      border-radius: var(--btn-radius);
      cursor: pointer;
      font-weight: 600;
      box-shadow: var(--btn-shadow);
      transition: box-shadow .2s ease, transform .15s ease, filter .2s ease;
    }
    button:hover {
      box-shadow: var(--btn-shadow-hover);
      transform: translateY(-1px);
      filter: brightness(1.03);
    }
    .error {
      color: #1f8a5a;
      margin-top: 10px;
      text-align: center;
      font-size: 14px;
    }
    .link {
      text-align: center;
      margin-top: 20px;
    }
    .link a {
      color: #1f8a5a;
      text-decoration: none;
    }
    .link a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div id="bg-animated" aria-hidden="true"></div>
  <div class="login-container">
    <div style="display:flex;justify-content:flex-end;margin-bottom:12px;">
      <%- include('partials/lang-switcher') %>
    </div>
    <h2><%= t('auth.loginHeading') %></h2>

    <form id="loginForm" method="POST" action="/user/login">
      <input type="text" name="username" id="username" placeholder="<%= t('auth.username') %>" required>
      <input type="password" name="password" id="password" placeholder="<%= t('auth.password') %>" required>
      <input type="hidden" name="_csrf" id="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="next" id="loginNext" value="<%= typeof nextPath !== 'undefined' && nextPath ? nextPath : '/cabinet' %>">
      <button type="submit"><%= t('auth.submitLogin') %></button>
    </form>

    <div id="loginError">
      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>
    </div>

    <div class="link">
      <a href="/forgot-password"><%= t('auth.forgotPassword') %></a>
    </div>
    <div class="link">
      <a href="/"><%= t('common.back') %></a>
      ·
      <a href="/register"><%= t('nav.register') %></a>
    </div>
  </div>

  <script>
    window.__I18N__ = <%- JSON.stringify(typeof i18nBundle !== 'undefined' ? i18nBundle : { locale: 'en', js: {} }) %>;
  </script>
  <script src="/js/i18n-client.js"></script>
  <script>
    (function(){
      function renderResend(email){
        if (!email) return '';
        var label = '<%= t("auth.resendVerification") %>';
        return '<div class="link" style="margin-top:12px;"><button type="button" id="resendVerificationBtn" class="btn outline small" data-email="' + email.replace(/"/g, '&quot;') + '">' + label + '</button></div>';
      }
      function showError(msg){
        var container = document.getElementById('loginError');
        container.textContent = '';
        var p = document.createElement('p');
        p.className = 'error';
        p.textContent = msg || (window.i18nT && window.i18nT('networkError')) || (window.__I18N__ && window.__I18N__.js && window.__I18N__.js.networkError) || 'Error';
        container.appendChild(p);
      }

      async function resendVerification(email){
        if (!email) return;
        try {
          var csrf = document.getElementById('_csrf').value;
          var res = await fetch(window.location.origin + '/resend-verification', {
            method: 'POST',
            credentials: 'include',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'X-CSRF-Token': csrf
            },
            body: JSON.stringify({ email: email })
          });
          var data = await res.json();
          showError((data && data.message) || '<%= t("auth.resendVerification") %>');
        } catch (err) {
          showError(window.i18nT ? window.i18nT('networkOrServer', '<%= t("auth.networkUnavailable") %>') : '<%= t("auth.networkUnavailable") %>');
        }
      }

      document.addEventListener('DOMContentLoaded', function(){
        var form = document.getElementById('loginForm');
        if (!form) return;

        document.addEventListener('click', function(e){
          var btn = e.target.closest('#resendVerificationBtn');
          if (!btn) return;
          resendVerification(btn.getAttribute('data-email'));
        });

        form.addEventListener('submit', async function(e){
          e.preventDefault();

          var username = document.getElementById('username').value;
          var password = document.getElementById('password').value;
          var csrf = document.getElementById('_csrf').value;
          var nextEl = document.getElementById('loginNext');
          var next = nextEl ? nextEl.value : '/cabinet';

          try {
            var res = await fetch(window.location.origin + '/user/login', {
              method: 'POST',
              credentials: 'include',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
                'X-CSRF-Token': csrf
              },
              body: JSON.stringify({ username: username, password: password, next: next })
            });

            if (res.redirected) {
              window.location = res.url;
              return;
            }

            var ct = res.headers.get('content-type') || '';
            if (ct.indexOf('application/json') !== -1) {
              var data = await res.json();
              if (data && data.success) {
                window.location = data.redirect || '/cabinet';
              } else {
                showError(data && data.message ? data.message : (window.i18nT ? window.i18nT('loginWrong', '<%= t("auth.loginError") %>') : '<%= t("auth.loginError") %>'));
                if (data && data.showResendVerification && data.email) {
                  document.getElementById('loginError').insertAdjacentHTML('beforeend', renderResend(data.email));
                }
              }
            } else if (res.ok) {
              var text = await res.text();
              if (/Íåâåðíûé|îøèáê|ïîäòâåðäèòå|invalid|wrong|confirm/i.test(text)) {
                showError(window.i18nT ? window.i18nT('loginWrong', '<%= t("auth.loginError") %>') : '<%= t("auth.loginError") %>');
              } else {
                showError(window.i18nT ? window.i18nT('loginWrong', '<%= t("auth.loginError") %>') : '<%= t("auth.loginError") %>');
              }
            } else {
              var errText = await res.text();
              showError(errText || (window.i18nT ? window.i18nT('loginWrong', '<%= t("auth.loginError") %>') : '<%= t("auth.loginError") %>'));
            }
          } catch (err) {
            console.error('Login error:', err);
            showError(window.i18nT ? window.i18nT('networkOrServer', '<%= t("auth.networkUnavailable") %>') : '<%= t("auth.networkUnavailable") %>');
          }
        });
      });
    })();
  </script>
</body>
</html>