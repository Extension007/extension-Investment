<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
<head>
  <meta charset="UTF-8">
  <title><%= t('form.editProduct') %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' && csrfToken ? csrfToken : '' %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css?v=1.3.9">
</head>
<body>
  <div id="bg-animated" aria-hidden="true"></div>
  <header class="main-header">
    <div class="container header-inner">
      <a class="logo" href="/"><img src="/albamount.png" alt="ALBAMOUNT" class="logo-img"></a>
      <nav class="nav">
        <ul class="nav-list">
          <li><a class="nav-link" href="/"><%= t('nav.catalog') %></a></li>
        </ul>
      </nav>
      <div class="header-actions">
        <%- include('../partials/lang-switcher') %>
        <a class="btn outline" href="<%= mode === 'admin' ? '/admin' : '/cabinet' %>">← <%= t('common.back') %></a>
      </div>
    </div>
  </header>

  <main class="container">
    <section class="section">
      <h2><%= t('form.editProduct') %></h2>
      <form id="editProductForm" class="form-grid" enctype="multipart/form-data" method="POST" action="<%= mode === 'admin' ? (product.type === 'service' ? `/admin/services/${product._id}/edit` : `/admin/products/${product._id}/edit`) : `/cabinet/product/${product._id}/edit` %>">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <input type="hidden" id="productId" value="<%= product._id %>">
        
        <div class="form-section">
          <label for="type"><%= t('js.typeCard') %>:</label>
          <select id="type" name="type" required aria-label="<%= t('js.typeCard') %>">
            <option value="product" <%= (product.type || 'product') === 'product' ? 'selected' : '' %>><%= t('js.typeProduct') %></option>
            <option value="service" <%= product.type === 'service' ? 'selected' : '' %>><%= t('js.typeService') %></option>
          </select>
        </div>
        
        <input type="text" name="name" value="<%= product.name %>" placeholder="<%= t('cabinet.name') %>" required aria-label="<%= t('cabinet.name') %>">
        <textarea name="description" placeholder="<%= t('cabinet.description') %>" rows="4" aria-label="<%= t('cabinet.description') %>"><%= product.description || '' %></textarea>
        <input type="text" name="price" value="<%= product.price %>" placeholder="<%= t('cabinet.price') %>" required maxlength="80" aria-label="<%= t('cabinet.price') %>">
        <input type="url" name="link" value="<%= product.link || '' %>" placeholder="<%= t('cabinet.link') %>" aria-label="<%= t('cabinet.link') %>">
        <input type="url" name="video_url" value="<%= product.video_url || '' %>" placeholder="<%= t('cabinet.video') %>" aria-label="<%= t('cabinet.video') %>">
        
        <div class="form-section">
          <h3><%= t('catalog.contacts') %></h3>
          <input type="tel" name="phone" value="<%= (product.contacts && product.contacts.phone) || '' %>" placeholder="<%= t('cabinet.phone') %>" aria-label="<%= t('cabinet.phone') %>">
          <input type="email" name="email" value="<%= (product.contacts && product.contacts.email) || '' %>" placeholder="<%= t('cabinet.email') %>" aria-label="<%= t('cabinet.email') %>">
          <input type="text" name="telegram" value="<%= (product.contacts && product.contacts.telegram) || '' %>" placeholder="<%= t('cabinet.telegram') %>" aria-label="<%= t('cabinet.telegram') %>">
          <input type="text" name="whatsapp" value="<%= (product.contacts && product.contacts.whatsapp) || '' %>" placeholder="<%= t('cabinet.whatsapp') %>" aria-label="<%= t('cabinet.whatsapp') %>">
          <textarea name="contact_method" placeholder="<%= t('cabinet.contactMethod') %>" rows="2" aria-label="<%= t('cabinet.contactMethod') %>"><%= (product.contacts && product.contacts.contact_method) || '' %></textarea>
        </div>

        <!-- Текущие изображения -->
        <% 
          const currentImages = product.images && Array.isArray(product.images) && product.images.length > 0 
            ? product.images 
            : (product.image_url ? [product.image_url] : []);
        %>
        <% if (currentImages.length > 0) { %>
          <div class="form-section">
            <h3><%= t('cabinet.images') %>:</h3>
            <div class="current-images-container" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(100px, 1fr));gap:10px;margin-bottom:10px;" role="group" aria-label="<%= t('cabinet.images') %>">
              <% currentImages.forEach((img, idx) => { %>
                <div class="current-image-item image-wrapper" data-image-index="<%= idx %>" style="position:relative;aspect-ratio:1;overflow:hidden;border-radius:8px;border:2px solid #ddd;">
                  <img src="<%= img %>" alt="<%= t('catalog.imageOf') %> <%= idx + 1 %>" data-original-url="<%= img %>" style="width:100%;height:100%;object-fit:cover;">
                  <button type="button" class="remove-image-btn image-delete-button" data-image-index="<%= idx %>" aria-label="<%= t('common.delete') %>" style="position:absolute;top:5px;right:5px;background:#f44336;color:#fff;border:none;border-radius:50%;width:24px;height:24px;cursor:pointer;font-size:18px;line-height:1;">×</button>
                </div>
              <% }) %>
            </div>
            <input type="hidden" name="current_images" id="currentImagesInput" value="<%= JSON.stringify(currentImages) %>">
          </div>
        <% } %>

        <!-- Загрузка новых изображений -->
        <div class="form-section">
          <label for="images"><%= t('form.uploadImages') %></label>
          <input 
            type="file" 
            id="images" 
            name="images" 
            accept="image/png,image/jpeg,image/jpg,image/webp" 
            multiple
            data-max-files="5"
            aria-label="<%= t('form.uploadImages') %>"
          >
          <small class="form-hint"><%= t('form.maxImages') %></small>
          <div id="imagePreview" class="image-preview-container" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(100px, 1fr));gap:10px;margin-top:10px;" role="group" aria-label="<%= t('cabinet.images') %>"></div>
        </div>

        <div class="form-section">
          <label><%= t('cabinet.category') %>:</label>
          <div id="categorySelector">
            <select name="category" id="categorySelect" required aria-label="<%= t('cabinet.category') %>">
              <option value=""><%= t('form.selectCategory') %></option>
              <% if (product.categoryId) { %>
                <option value="<%= product.categoryId %>" selected><%= product.category || t('form.selectCategory') %></option>
              <% } %>
              <option value="home" <%= (product.category === 'home' || (product.category && String(product.category).startsWith('home.'))) ? 'selected' : '' %>><%= t('categories:home', { defaultValue: 'home', keySeparator: false }) %></option>
              <option value="beauty" <%= (product.category === 'beauty' || (product.category && String(product.category).startsWith('beauty.'))) ? 'selected' : '' %>><%= t('categories:beauty', { defaultValue: 'beauty', keySeparator: false }) %></option>
              <option value="auto" <%= (product.category === 'auto' || (product.category && String(product.category).startsWith('auto.'))) ? 'selected' : '' %>><%= t('categories:auto', { defaultValue: 'auto', keySeparator: false }) %></option>
              <option value="electronics" <%= (product.category === 'electronics' || (product.category && String(product.category).startsWith('electronics.'))) ? 'selected' : '' %>><%= t('categories:electronics', { defaultValue: 'electronics', keySeparator: false }) %></option>
              <option value="household" <%= (product.category === 'household' || (product.category && String(product.category).startsWith('household.'))) ? 'selected' : '' %>><%= t('categories:household', { defaultValue: 'household', keySeparator: false }) %></option>
              <option value="pets" <%= (product.category === 'pets' || (product.category && String(product.category).startsWith('pets.'))) ? 'selected' : '' %>><%= t('categories:pets', { defaultValue: 'pets', keySeparator: false }) %></option>
              <option value="hobbies" <%= (product.category === 'hobbies' || (product.category && String(product.category).startsWith('hobbies.'))) ? 'selected' : '' %>><%= t('categories:hobbies', { defaultValue: 'hobbies', keySeparator: false }) %></option>
              <option value="eco" <%= (product.category === 'eco' || (product.category && String(product.category).startsWith('eco.'))) ? 'selected' : '' %>><%= t('categories:eco', { defaultValue: 'eco', keySeparator: false }) %></option>
              <option value="digital" <%= (product.category === 'digital' || (product.category && String(product.category).startsWith('digital.'))) ? 'selected' : '' %>><%= t('categories:digital', { defaultValue: 'digital', keySeparator: false }) %></option>
              <option value="additional" <%= (product.category === 'additional' || (product.category && String(product.category).startsWith('additional.'))) ? 'selected' : '' %>><%= t('categories:additional', { defaultValue: 'additional', keySeparator: false }) %></option>
            </select>
            <div id="hierarchicalCategories" style="margin-top: 10px; display: none;">
            </div>
          </div>
        </div>

        <%- include('../partials/location-tags-fields', { product: product }) %>

        <button type="submit" class="btn primary" aria-label="<%= t('cabinet.save') %>"><%= t('cabinet.save') %></button>
      </form>
      <div id="editProductMsg" class="note" style="margin-top:10px;" role="status" aria-live="polite"></div>
    </section>
  </main>


  <div id="serverData" data-product-id="<%= product._id %>" data-mode="<%= mode || 'user' %>" data-current-images="<%= JSON.stringify(currentImages) %>" style="display:none;"></div>

  <script>
    window.__I18N__ = <%- JSON.stringify(typeof i18nBundle !== 'undefined' ? i18nBundle : { locale: 'en', js: {} }) %>;
  </script>
  <script src="/js/i18n-client.js"></script>
  <script src="/js/location-tags.js?v=1.0.2"></script>
  <script src="/js/compress-images.js?v=1.0.2"></script>
  <script src="/js/edit-form.js?v=1.0.3"></script>
  <script>
    const serverDataEl = document.getElementById('serverData');
    const productId = serverDataEl.dataset.productId;
    const mode = serverDataEl.dataset.mode;
    const currentImagesData = JSON.parse(serverDataEl.dataset.currentImages || '[]');

    (function() {
      function initializeForm() {
        if (typeof initEditForm === 'function') {
          initEditForm({
            mode: mode,
            productId: productId,
            currentImages: currentImagesData
          });
        }
      }
      
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeForm);
      } else {
        setTimeout(initializeForm, 0);
      }
    })();
    
    const hierarchicalCategories = <%- JSON.stringify(typeof hierarchicalCategories !== 'undefined' && hierarchicalCategories ? hierarchicalCategories : {}) %>;

    function buildHierarchicalSelector(parentElement, categories, prefix = '', level = 0, currentValue = '') {
      parentElement.innerHTML = '';
      
      const container = document.createElement('div');
      container.style.marginLeft = level * 20 + 'px';
      container.style.marginTop = '10px';
      
      const select = document.createElement('select');
      select.className = 'category-select';
      select.setAttribute('data-level', level);
      select.innerHTML = '<option value="">' + (window.i18nT ? window.i18nT('selectCategory', '...') : '...') + '</option>';
      
      for (const [key, value] of Object.entries(categories)) {
        const option = document.createElement('option');
        const fullKey = prefix ? `${prefix}.${key}` : key;
        option.value = fullKey;
        option.textContent = value.label;
        
        // Если это текущее значение категории или его часть, делаем его выбранным
        if (currentValue === fullKey || currentValue.startsWith(fullKey + '.')) {
          option.selected = true;
        }
        
        select.appendChild(option);
      }
      
      container.appendChild(select);
      parentElement.appendChild(container);
      
      select.addEventListener('change', function() {
        const selectedValue = this.value;
        if (selectedValue) {
          // Обновляем скрытое поле категории
          document.querySelector('input[name="category"], select[name="category"]').value = selectedValue;
          
          // Удаляем все дочерние селекторы
          const childSelectors = parentElement.querySelectorAll(`.category-select[data-level]:not([data-level="${level}"])`);
          childSelectors.forEach(child => {
            if (parseInt(child.getAttribute('data-level')) > level) {
              child.closest('div').remove();
            }
          });
          
          // Если у выбранной категории есть подкатегории, создаем новый селектор
          const categoryPath = selectedValue.split('.');
          let currentCategory = hierarchicalCategories;
          
          for (const path of categoryPath) {
            if (currentCategory && currentCategory[path]) {
              currentCategory = currentCategory[path].children;
            } else {
              currentCategory = null;
              break;
            }
          }
          
          if (currentCategory) {
            buildHierarchicalSelector(parentElement, currentCategory, level + 1, selectedValue, currentValue);
          }
        }
      });
      
      // Если у нас есть текущее значение и это не самый глубокий уровень, продолжаем строить иерархию
      if (currentValue) {
        const currentValueParts = currentValue.split('.');
        if (currentValueParts.length > level + 1) {
          const nextLevelKey = currentValueParts[level + 1];
          const currentCategoryPath = currentValueParts.slice(0, level + 1).join('.');
          
          let currentCategory = hierarchicalCategories;
          for (const path of currentValueParts.slice(0, level + 1)) {
            if (currentCategory && currentCategory[path]) {
              currentCategory = currentCategory[path].children;
            } else {
              currentCategory = null;
              break;
            }
          }
          
          if (currentCategory && currentCategory[nextLevelKey]) {
            buildHierarchicalSelector(parentElement, currentCategory[nextLevelKey].children, level + 1, currentValueParts.slice(0, level + 1).join('.'), '<%= product.category %>');
          }
        }
      }
    }

    // Инициализация иерархического выбора категорий
    document.addEventListener('DOMContentLoaded', function() {
      const categorySelector = document.getElementById('categorySelector');
      const hierarchicalDiv = document.getElementById('hierarchicalCategories');
      const categorySelect = document.getElementById('categorySelect');
      
      // Функция для обновления отображения иерархического выбора
      function updateHierarchicalDisplay() {
        const currentCategory = '<%= product.category %>';
        const hasHierarchicalPrefix = currentCategory.includes('.');
        
        // Проверяем, является ли выбранная категория частью иерархической структуры
        const isHierarchicalCategory = Object.keys(hierarchicalCategories).some(key =>
          currentCategory === key || currentCategory.startsWith(key + '.')
        );
        
        if (categorySelect.value === '' || isHierarchicalCategory) {
          hierarchicalDiv.style.display = 'block';
          buildHierarchicalSelector(hierarchicalDiv, hierarchicalCategories, 0, '', currentCategory);
        } else {
          hierarchicalDiv.style.display = 'none';
        }
      }
      
      categorySelect.addEventListener('change', function() {
        const selectedValue = this.value;
        if (selectedValue) {
          // Если выбрана конкретная категория, скрываем иерархический выбор
          hierarchicalDiv.style.display = 'none';
        } else {
          // Если выбрана пустая опция, показываем иерархический выбор
          hierarchicalDiv.style.display = 'block';
          buildHierarchicalSelector(hierarchicalDiv, hierarchicalCategories, 0, '', '<%= product.category %>');
        }
      });
      
      // Инициализируем отображение
      updateHierarchicalDisplay();
    });
  </script>
</body>
</html>
