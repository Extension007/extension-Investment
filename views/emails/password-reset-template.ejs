<%- include('partials/email-start', { locale, subject, preheader, logoUrl }) %>
<div style="padding:0 28px 26px; font-family:'Poppins',Arial,sans-serif;">
  <div style="padding:20px; border:1px solid rgba(31,138,90,0.35); border-radius:14px; background:rgba(31,138,90,0.04); box-shadow:0 10px 30px rgba(0,0,0,0.25);">
    <h1 style="margin:0 0 14px; font-size:24px; color:#e6c96a; text-align:center; font-weight:700; letter-spacing:.6px;">
      <%= copy.heading %>
    </h1>
    <p style="margin:0 0 12px; font-size:15px; line-height:1.7; color:#e5e7eb; text-align:center;">
      <%= interpolate(copy.greeting, { username }) %>
    </p>
    <div style="text-align:center; margin:22px 0 12px;">
      <a href="<%= resetLink %>" target="_blank"
         style="display:inline-block; padding:14px 32px; background:linear-gradient(135deg, #1f8a5a, #c9a227); color:#fff; text-decoration:none; border-radius:12px; font-weight:700; font-size:15px; letter-spacing:.3px; box-shadow:0 10px 25px rgba(31, 138, 90, 0.35);">
        <%= copy.cta %>
      </a>
    </div>
    <p style="margin:14px 0 10px; font-size:13px; color:#9ca3af; text-align:center;">
      <%= copy.fallback %>
    </p>
    <p style="margin:0; padding:12px; font-size:13px; word-break:break-all; color:#d1d5db; text-align:center; background:rgba(31,138,90,0.06); border:1px dashed rgba(31,138,90,0.4); border-radius:10px;">
      <a href="<%= resetLink %>" style="color:#ff8f8f; text-decoration:none;"><%= resetLink %></a>
    </p>
    <div style="margin:18px 0 0; padding:12px; border-radius:10px; border:1px solid rgba(31,138,90,0.25); background:rgba(31,138,90,0.08); text-align:center; color:#e8d5a3; font-size:13px;">
      <%= interpolate(copy.validity, { validityPeriod }) %>
    </div>
    <p style="margin:18px 0 0; font-size:13px; color:#9ca3af; text-align:center; line-height:1.6;">
      <%= copy.ignore %>
    </p>
  </div>
</div>
<%- include('partials/email-end', { baseUrl, supportEmail, footerHelpText }) %>
