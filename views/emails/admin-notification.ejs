<%- include('partials/email-start', { locale, subject, preheader, logoUrl }) %>
<div style="padding:0 28px 26px; font-family:'Poppins',Arial,sans-serif;">
<div style="padding:20px; border:1px solid rgba(31,138,90,0.35); border-radius:14px; background:rgba(31,138,90,0.04); box-shadow:0 10px 30px rgba(0,0,0,0.25);">
<h1 style="margin: 0 0 16px; font-size: 24px; color: #e6c96a; text-align: center;">
  <%= copy.heading %>
</h1>
<p style="margin: 0 0 12px; font-size: 15px; line-height: 1.6; color:#e5e7eb;">
  <%= copy.typeLabel %> <strong style="color:#ffdf8c;"><%= eventType %></strong>
</p>
<p style="margin: 0 0 20px; font-size: 15px; line-height: 1.6; color:#d1d5db;">
  <%= details %>
</p>
<% if (data && Object.keys(data).length > 0) { %>
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 20px; border-collapse: collapse; background: rgba(255,255,255,0.02); border-radius: 10px;">
    <% Object.entries(data).forEach(([key, value]) => { %>
      <tr>
        <td style="padding: 8px 10px; font-size: 13px; color: #9ca3af; width: 40%;"><%= key %></td>
        <td style="padding: 8px 10px; font-size: 13px; color: #f3f4f6;"><%= value %></td>
      </tr>
    <% }); %>
  </table>
<% } %>
<table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 0 auto 12px;">
  <tr>
    <td align="center" style="border-radius: 10px; background: linear-gradient(135deg, #1f8a5a, #c9a227);">
      <a href="<%= adminPanelLink %>" target="_blank" style="display: inline-block; padding: 12px 26px; color: #ffffff; text-decoration: none; border-radius: 10px; font-weight: 700; font-size: 14px;">
        <%= copy.cta %>
      </a>
    </td>
  </tr>
</table>
</div>
</div>
<%- include('partials/email-end', { baseUrl, supportEmail, footerHelpText }) %>
