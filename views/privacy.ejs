<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
<head>
  <meta charset="UTF-8">
  <title><%= t('meta.privacyTitle') %></title>
  <%- include('partials/seo-head', {
    canonicalPath: '/privacy',
    seoTitle: t('meta.privacyTitle'),
    seoDescription: t('meta.privacyDescription')
  }) %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css?v=1.4.0">
  <link rel="stylesheet" href="/header-tabs.css?v=1.1.4">
  <style>
    .legal-page { max-width: 760px; margin: 0 auto; color: #eee; line-height: 1.65; }
    .legal-page h1 { margin: 0 0 8px; font-size: 1.7rem; }
    .legal-page .updated { opacity: .7; font-size: .9rem; margin: 0 0 20px; }
    .legal-page h2 { margin: 28px 0 10px; font-size: 1.15rem; color: #e8d5a3; }
    .legal-page p, .legal-page li { opacity: .92; }
    .legal-page ul { padding-left: 1.2rem; }
    .legal-page a { color: #c8f5d8; }
  </style>
</head>
<body>
  <%- include('partials/header') %>
  <main class="container" style="padding-top: 100px; padding-bottom: 110px;">
    <article class="legal-page">
      <h1><%= t('privacy.title') %></h1>
      <p class="updated"><%= t('privacy.updated') %></p>
      <p><%= t('privacy.intro') %></p>

      <h2><%= t('privacy.whoTitle') %></h2>
      <p><%= t('privacy.whoBody') %></p>

      <h2><%= t('privacy.dataTitle') %></h2>
      <ul>
        <li><%= t('privacy.dataAccount') %></li>
        <li><%= t('privacy.dataContent') %></li>
        <li><%= t('privacy.dataTech') %></li>
        <li><%= t('privacy.dataMessages') %></li>
      </ul>

      <h2><%= t('privacy.whyTitle') %></h2>
      <p><%= t('privacy.whyBody') %></p>

      <h2><%= t('privacy.shareTitle') %></h2>
      <p><%= t('privacy.shareBody') %></p>

      <h2><%= t('privacy.retentionTitle') %></h2>
      <p><%= t('privacy.retentionBody') %></p>

      <h2><%= t('privacy.rightsTitle') %></h2>
      <p><%= t('privacy.rightsBody') %></p>

      <h2><%= t('privacy.childrenTitle') %></h2>
      <p><%= t('privacy.childrenBody') %></p>

      <h2><%= t('privacy.contactTitle') %></h2>
      <p><%= t('privacy.contactBody') %></p>
    </article>
  </main>
  <%- include('partials/mobile-tabs') %>
  <script src="/script.js?v=1.4.3" defer></script>
</body>
</html>
