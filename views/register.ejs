<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('meta.registerTitle') %></title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="stylesheet" href="/styles.css?v=1.3.9">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <style>
    /* Дополнительные стили для страницы регистрации */
    .register-page {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .register-container {
      width: 100%;
      max-width: 400px;
      background: var(--color-surface);
      border-radius: var(--radius-md);
      padding: 30px;
      box-shadow: var(--shadow-card);
      border: 1px solid rgba(31, 138, 90, 0.2);
    }

    .register-title {
      text-align: center;
      margin-bottom: 30px;
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--color-text);
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group label {
      display: block;
      margin-bottom: 8px;
      font-weight: 600;
      color: var(--color-muted);
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .form-group input {
      width: 100%;
      padding: 12px;
      background: var(--color-surface-alt);
      border: 1px solid rgba(31, 138, 90, 0.3);
      border-radius: var(--radius-sm);
      color: #ffffff;
      -webkit-text-fill-color: #ffffff;
      caret-color: #ffffff;
      font-family: inherit;
      font-size: 0.95rem;
    }

    .form-group input::placeholder {
      color: rgba(255, 255, 255, 0.55);
      -webkit-text-fill-color: rgba(255, 255, 255, 0.55);
      opacity: 1;
    }

    .form-group input:focus {
      outline: none;
      border-color: var(--color-accent);
      box-shadow: 0 0 8px rgba(31, 138, 90, 0.3);
      color: #ffffff;
      -webkit-text-fill-color: #ffffff;
    }

    .form-group input:-webkit-autofill,
    .form-group input:-webkit-autofill:hover,
    .form-group input:-webkit-autofill:focus {
      -webkit-text-fill-color: #ffffff !important;
      caret-color: #ffffff;
      transition: background-color 99999s ease-in-out 0s;
      box-shadow: 0 0 0 1000px var(--color-surface-alt) inset;
    }

    .form-group input[readonly] {
      background: rgba(31, 138, 90, 0.1);
      border-color: rgba(31, 138, 90, 0.4);
      color: #ffffff;
      -webkit-text-fill-color: #ffffff;
      cursor: not-allowed;
    }

    .account-type-options {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .account-type-option {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      padding: 12px;
      border: 1px solid rgba(31, 138, 90, 0.3);
      border-radius: 8px;
      cursor: pointer;
      background: var(--color-surface-alt);
    }
    .account-type-option small {
      display: block;
      margin-top: 4px;
      color: rgba(255,255,255,0.6);
      font-weight: 400;
      text-transform: none;
      letter-spacing: 0;
    }
      width: 100%;
      padding: 14px;
      font-size: 1rem;
      font-weight: 600;
      margin-top: 10px;
    }

    .auth-links {
      margin-top: 25px;
      text-align: center;
    }

    .auth-links a {
      color: var(--color-accent);
      text-decoration: none;
      font-weight: 600;
    }

    .auth-links a:hover {
      text-decoration: underline;
    }

    .error-message {
      color: #b00020;
      background: rgba(176, 0, 32, 0.1);
      border: 1px solid rgba(176, 0, 32, 0.3);
      padding: 12px;
      border-radius: var(--radius-sm);
      margin-top: 15px;
      text-align: center;
      display: none;
    }

    .success-message {
      color: #4caf50;
      background: rgba(76, 175, 80, 0.1);
      border: 1px solid rgba(76, 175, 80, 0.3);
      padding: 12px;
      border-radius: var(--radius-sm);
      margin-top: 15px;
      text-align: center;
      display: none;
    }
  </style>
</head>
<body>
  <div id="bg-animated" aria-hidden="true"></div>
  <div class="register-page">
    <div class="register-container">
      <div style="display:flex;justify-content:flex-end;margin-bottom:12px;">
        <%- include('partials/lang-switcher') %>
      </div>
      <h1 class="register-title"><%= t('nav.register') %></h1>

      <form id="registerForm" action="/register" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label for="username"><%= t('auth.nickname') %></label>
          <input type="text" id="username" name="username" placeholder="<%= t('auth.nicknamePlaceholder') %>" required>
        </div>

        <div class="form-group">
          <label for="email"><%= t('auth.email') %></label>
          <input type="email" id="email" name="email" placeholder="<%= t('auth.emailPlaceholder') %>" required>
        </div>

        <div class="form-group">
          <label for="password"><%= t('auth.password') %></label>
          <input type="password" id="password" name="password" placeholder="<%= t('auth.passwordPlaceholder') %>" required>
        </div>

        <div class="form-group">
          <label><%= t('auth.accountType') %></label>
          <div class="account-type-options">
            <label class="account-type-option">
              <input type="radio" name="accountType" value="services">
              <span><strong><%= t('auth.accountTypeServices') %></strong><small><%= t('auth.accountTypeServicesHint') %></small></span>
            </label>
            <label class="account-type-option">
              <input type="radio" name="accountType" value="showcase" required>
              <span><strong><%= t('auth.accountTypeAds') %></strong><small><%= t('auth.accountTypeAdsHint') %></small></span>
            </label>
          </div>
        </div>

        <% if (refCode) { %>
          <div class="form-group">
            <label for="refCode"><%= t('auth.refCode') %></label>
            <input type="text" id="refCode" name="refCode" value="<%= refCode %>" readonly>
            <input type="hidden" name="ref" value="<%= refCode %>">
          </div>
        <% } else { %>
          <div class="form-group">
            <label for="refCode"><%= t('auth.refCode') %></label>
            <input type="text" id="refCode" name="refCode" placeholder="<%= t('auth.refCodePlaceholder') %>">
          </div>
        <% } %>

        <button type="submit" class="btn register-button"><%= t('auth.createAccount') %></button>
      </form>

      <div id="registerError" class="error-message"></div>
      <div id="registerSuccess" class="success-message"></div>

      <div class="auth-links">
        <p><%= t('auth.haveAccount') %> <a href="/user/login"><%= t('auth.submitLogin') %></a></p>
      </div>
    </div>
  </div>

  <script>
    window.__I18N__ = <%- JSON.stringify(typeof i18nBundle !== 'undefined' ? i18nBundle : { locale: 'en', js: {} }) %>;
    // Обработка формы регистрации
    document.getElementById('registerForm').addEventListener('submit', async function(e) {
      e.preventDefault();

      const form = e.target;
      const formData = new FormData(form);
      const errorElement = document.getElementById('registerError');
      const successElement = document.getElementById('registerSuccess');

try {
         const response = await fetch(form.action, {
           method: 'POST',
           headers: {
             'Content-Type': 'application/json',
             'X-CSRF-Token': formData.get('_csrf')
           },
           body: JSON.stringify({
            username: formData.get('username'),
            email: formData.get('email'),
            password: formData.get('password'),
            accountType: formData.get('accountType'),
            refCode: formData.get('refCode'),
            ref: formData.get('ref')
          })
        });

        const data = await response.json();

        if (data.success) {
          errorElement.style.display = 'none';
          successElement.style.display = 'block';
          successElement.textContent = data.message || '<%= t("auth.registerSuccess") %>';
          form.reset();

          // Перенаправление через 3 секунды
          setTimeout(() => {
            window.location.href = '/user/login';
          }, 3000);
        } else {
          errorElement.style.display = 'block';
          errorElement.textContent = data.message || '<%= t("common.error") %>';
          successElement.style.display = 'none';
        }
      } catch (error) {
        errorElement.style.display = 'block';
        errorElement.textContent = '<%= t("js.networkError") %>';
        successElement.style.display = 'none';
      }
    });
  </script>
</body>
</html>
