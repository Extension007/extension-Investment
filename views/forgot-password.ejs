<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
<head>
  <meta charset="UTF-8">
  <title><%= t('meta.forgotPasswordTitle') %></title>
  <meta name="robots" content="noindex, nofollow">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css?v=1.3.9">
  <style>
    body { display:flex; align-items:center; justify-content:center; min-height:100vh; background:#2b2b2b; padding:20px; }
    .login-container { background:#1a1a1a; padding:40px; border-radius:12px; box-shadow:0 4px 20px rgba(0,0,0,.5); width:100%; max-width:400px; }
    h2 { text-align:center; margin-bottom:12px; color:#fff; }
    .lead { text-align:center; color:#bbb; font-size:14px; line-height:1.5; margin:0 0 22px; }
    form { display:flex; flex-direction:column; gap:15px; }
    input { padding:12px; font-size:14px; border:1px solid #444; border-radius:8px; background:#2b2b2b; color:#fff; }
    button { padding:12px; background:var(--btn-bg); color:var(--color-text); border:2px solid transparent; border-radius:var(--btn-radius); cursor:pointer; font-weight:600; }
    .error { color:#e88; margin-top:10px; text-align:center; font-size:14px; }
    .success { color:#8dcfb0; margin-top:10px; text-align:center; font-size:14px; }
    .link { text-align:center; margin-top:20px; }
    .link a { color:#1f8a5a; text-decoration:none; }
  </style>
</head>
<body>
  <div id="bg-animated" aria-hidden="true"></div>
  <div class="login-container">
    <div style="display:flex;justify-content:flex-end;margin-bottom:12px;">
      <%- include('partials/lang-switcher') %>
    </div>
    <h2><%= t('auth.forgotHeading') %></h2>
    <p class="lead"><%= t('auth.forgotLead') %></p>
    <form method="POST" action="/forgot-password">
      <input type="email" name="email" placeholder="<%= t('auth.email') %>" required autocomplete="email">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit"><%= t('auth.sendResetLink') %></button>
    </form>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <% if (success) { %><p class="success"><%= success %></p><% } %>
    <div class="link">
      <a href="/user/login"><%= t('nav.login') %></a>
      ·
      <a href="/"><%= t('common.back') %></a>
    </div>
  </div>
</body>
</html>
