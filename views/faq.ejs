<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
<head>
  <meta charset="UTF-8">
  <title><%= t('meta.faqTitle') %></title>
  <%- include('partials/seo-head', {
    canonicalPath: '/faq',
    seoTitle: t('meta.faqTitle'),
    seoDescription: t('meta.faqDescription')
  }) %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css?v=1.4.0">
  <link rel="stylesheet" href="/header-tabs.css?v=1.1.4">
  <style>
    .faq-page { max-width: 860px; margin: 0 auto; color: #eee; }
    .faq-page h1 { margin: 0 0 8px; font-size: 1.7rem; }
    .faq-updated { opacity: .7; font-size: .9rem; margin: 0 0 16px; }
    .faq-intro { margin: 0 0 20px; line-height: 1.65; }
    .faq-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
      margin-bottom: 22px;
    }
    .faq-search {
      flex: 1 1 220px;
      min-height: 40px;
      padding: 8px 12px;
      border-radius: 10px;
      border: 1px solid rgba(31, 138, 90, 0.35);
      background: rgba(10, 31, 22, 0.7);
      color: #fff;
    }
    .faq-toc { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 24px; }
    .faq-toc a {
      color: #e8d5a3;
      text-decoration: none;
      font-size: .9rem;
      border: 1px solid rgba(232, 213, 163, 0.25);
      border-radius: 999px;
      padding: 4px 10px;
    }
    .faq-group { margin: 0 0 28px; }
    .faq-group h2 { margin: 0 0 10px; font-size: 1.15rem; color: #e8d5a3; }
    .faq-item {
      border: 1px solid rgba(31, 138, 90, 0.25);
      border-radius: 12px;
      margin: 0 0 8px;
      background: rgba(13, 40, 28, 0.35);
    }
    .faq-item summary {
      cursor: pointer;
      list-style: none;
      padding: 12px 14px;
      font-weight: 600;
      line-height: 1.4;
    }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary::after {
      content: "+";
      float: right;
      color: #e8d5a3;
      font-weight: 700;
    }
    .faq-item[open] summary::after { content: "–"; }
    .faq-item p {
      margin: 0;
      padding: 0 14px 14px;
      line-height: 1.65;
      color: #ddd;
    }
    .faq-empty { display: none; margin: 12px 0 24px; opacity: .85; }
    .faq-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
  </style>
  <% if (typeof faqJsonLd !== 'undefined' && faqJsonLd) { %>
  <script type="application/ld+json"><%- faqJsonLd %></script>
  <% } %>
</head>
<body data-logged-in="<%= typeof isAuth !== 'undefined' && isAuth ? '1' : '0' %>">
  <div id="bg-animated" aria-hidden="true"></div>
  <%- include('partials/header') %>

  <main class="container">
    <section class="section">
      <article class="faq-page">
        <h1><%= faqDoc.title %></h1>
        <p class="faq-updated"><%= faqDoc.updated %></p>
        <p class="faq-intro"><%= faqDoc.intro %></p>

        <div class="faq-toolbar">
          <input type="search" id="faqSearch" class="faq-search" placeholder="<%= faqDoc.searchPlaceholder %>" maxlength="120">
          <button type="button" class="btn outline small" id="faqOpenAll"><%= faqDoc.openAll %></button>
          <button type="button" class="btn outline small" id="faqCloseAll"><%= faqDoc.closeAll %></button>
        </div>

        <nav class="faq-toc" aria-label="<%= faqDoc.toc %>">
          <% (faqDoc.groups || []).forEach(function (group) { %>
            <a href="#faq-<%= group.id %>"><%= group.title %></a>
          <% }) %>
        </nav>

        <p class="faq-empty" id="faqEmpty"><%= faqDoc.empty %></p>

        <% (faqDoc.groups || []).forEach(function (group) { %>
          <section class="faq-group" id="faq-<%= group.id %>" data-faq-group>
            <h2><%= group.title %></h2>
            <% (group.items || []).forEach(function (item) { %>
              <details class="faq-item" data-faq-item>
                <summary><%= item.q %></summary>
                <p><%= item.a %></p>
              </details>
            <% }) %>
          </section>
        <% }) %>

        <div class="faq-actions">
          <a class="btn" href="/contacts"><%= faqDoc.contactCta %></a>
          <a class="btn outline" href="/rules"><%= faqDoc.rulesCta %></a>
        </div>
      </article>
    </section>
  </main>

  <%- include('partials/mobile-tabs') %>
  <%- include('partials/register-modal') %>

  <script src="/utils/bootstrap.js?v=1.0.3"></script>
  <script>
    window.__I18N__ = <%- JSON.stringify(typeof i18nBundle !== 'undefined' ? i18nBundle : { locale: 'en', js: {} }) %>;
    window.AppBootstrap.init({
      isAuth: <%- JSON.stringify(typeof isAuth !== 'undefined' ? isAuth : false) %>,
      isAdmin: <%- JSON.stringify(typeof isAdmin !== 'undefined' ? isAdmin : false) %>,
      socketIoAvailable: <%- JSON.stringify(typeof socket_io_available !== 'undefined' ? socket_io_available : false) %>,
      userRole: <%- JSON.stringify(typeof userRole !== 'undefined' ? userRole : null) %>,
      userId: <%- JSON.stringify(typeof user !== 'undefined' && user && (user.id || user._id) ? String(user.id || user._id) : '') %>,
      csrfToken: <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '') %>
    });
  </script>
  <script src="/js/i18n-client.js"></script>
  <script>
    (function () {
      var search = document.getElementById('faqSearch');
      var empty = document.getElementById('faqEmpty');
      var items = Array.prototype.slice.call(document.querySelectorAll('[data-faq-item]'));
      var groups = Array.prototype.slice.call(document.querySelectorAll('[data-faq-group]'));

      function filterFaq() {
        var q = (search && search.value || '').trim().toLowerCase();
        var visible = 0;
        items.forEach(function (el) {
          var match = !q || (el.textContent || '').toLowerCase().indexOf(q) !== -1;
          el.hidden = !match;
          if (match) visible += 1;
        });
        groups.forEach(function (group) {
          var any = group.querySelectorAll('[data-faq-item]:not([hidden])').length > 0;
          group.hidden = !any;
        });
        if (empty) empty.style.display = visible ? 'none' : 'block';
      }

      if (search) search.addEventListener('input', filterFaq);
      var openAll = document.getElementById('faqOpenAll');
      var closeAll = document.getElementById('faqCloseAll');
      if (openAll) openAll.addEventListener('click', function () {
        items.forEach(function (el) { if (!el.hidden) el.open = true; });
      });
      if (closeAll) closeAll.addEventListener('click', function () {
        items.forEach(function (el) { el.open = false; });
      });
    })();
  </script>
  <script src="/script.js?v=1.1.3"></script>
  <script src="/fix-footer-overlap.js?v=1.0.1"></script>
</body>
</html>
