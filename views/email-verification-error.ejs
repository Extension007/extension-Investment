<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('auth.verifyEmailError') %> - Albamount</title>
  <link rel="stylesheet" href="/styles.css?v=1.4.0">
</head>
<body>
  <div id="bg-animated" aria-hidden="true"></div>
  <header class="main-header" style="position:relative;z-index:2;">
    <div class="container header-inner">
      <a class="logo" href="/"><img src="/albamount.png" alt="ALBAMOUNT" class="logo-img"></a>
      <div class="header-actions">
        <%- include('partials/lang-switcher') %>
      </div>
    </div>
  </header>
  <div class="auth-container">
    <div class="auth-form">
      <h2>? <%= t('auth.verifyEmailError') %></h2>
      
      <div class="error-message">
        <p><%= typeof error !== 'undefined' ? error : t('auth.verifyEmailError') %></p>
      </div>
      
      <div class="form-group">
        <a href="/user/login" class="btn btn-primary"><%= t('auth.goLogin') %></a>
      </div>
      
      <div class="auth-links">
        <p><a href="/"><%= t('common.back') %></a></p>
      </div>
    </div>
  </div>
</body>
</html>
